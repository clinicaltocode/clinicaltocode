# Supabase — CRITICAL: DATABASE_URL must use port 6543 (PgBouncer pooler)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PgBouncer pooler — port 6543 — runtime queries
DATABASE_URL=           # postgresql://postgres.[ref]:[pw]@aws-0-*.pooler.supabase.com:6543/postgres

# Direct connection — port 5432 — migrations ONLY, never runtime
DIRECT_URL=             # postgresql://postgres:[pw]@db.[ref].supabase.co:5432/postgres

# Site URL — http://localhost:3000 for dev, https://clinicaltocode.com for production
NEXT_PUBLIC_SITE_URL=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
